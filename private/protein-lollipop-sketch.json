{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",

  "description": "Protein mutation lollipop plot with scale-aware displaced labels",

  "padding": 12,
  "spacing": 0,
  "resolve": { "scale": { "x": "shared" } },

  "vconcat": [
    {
      "name": "mutations",
      "height": 300,
      "data": {
        "values": [
          { "position": 61, "count": 2.1, "label": "C61G" },
          { "position": 183, "count": 1.2, "label": "G183V" },
          { "position": 284, "count": 1.5, "label": "Q284*" },
          { "position": 339, "count": 1.4, "label": "K339fs" },
          { "position": 505, "count": 2.3, "label": "K505*" },
          { "position": 563, "count": 1.5, "label": "Q563*" },
          { "position": 1016, "count": 1.9, "label": "N1016fs" },
          { "position": 1077, "count": 3.5, "label": "V1077fs" },
          { "position": 1095, "count": 1.8, "label": "K1095fs" },
          { "position": 1115, "count": 1.7, "label": "I1115_E1116del" },
          { "position": 1203, "count": 1.8, "label": "R1203*" },
          { "position": 1373, "count": 4.2, "label": "E1373*" },
          { "position": 1655, "count": 1.6, "label": "S1655fs" },
          { "position": 1699, "count": 3.0, "label": "R1699W" },
          { "position": 1708, "count": 2.2, "label": "A1708E" },
          { "position": 1756, "count": 1.7, "label": "Q1756fs" },
          { "position": 1770, "count": 1.6, "label": "G1770W" }
        ]
      },
      "transform": [
        {
          "type": "displace1d",
          "pos": "position",
          "length": 22,
          "as": "xDisplacement"
        }
      ],
      "encoding": {
        "x": {
          "field": "position",
          "type": "index",
          "scale": { "domain": [0, 1863], "nice": false },
          "axis": null
        },
        "xOffset": {
          "field": "xDisplacement",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "scale": { "domain": [0, 7], "nice": false },
          "axis": {
            "title": "Mutation count",
            "grid": false,
            "values": [0, 1, 2, 3, 4, 5]
          }
        }
      },
      "layer": [
        {
          "name": "lower-connectors",
          "mark": {
            "type": "link",
            "linkShape": "diagonal",
            "orient": "vertical",
            "x2Offset": 0,
            "size": 1,
            "color": "#707070",
            "tooltip": null
          },
          "encoding": {
            "x2": { "field": "position" },
            "y": { "datum": 0.35, "type": "quantitative" },
            "y2": { "datum": 0, "type": "quantitative" }
          }
        },
        {
          "name": "true-position-anchors",
          "mark": {
            "type": "rule",
            "size": 1,
            "color": "#707070",
            "tooltip": null
          },
          "encoding": {
            "xOffset": { "value": 0 },
            "y": { "datum": 0, "type": "quantitative" },
            "y2": { "datum": 0.16, "type": "quantitative" }
          }
        },
        {
          "name": "stems",
          "mark": {
            "type": "rule",
            "size": 1.25,
            "color": "#707070",
            "tooltip": null
          },
          "encoding": {
            "y2": { "datum": 0.35, "type": "quantitative" }
          }
        },
        {
          "name": "upper-guides",
          "mark": {
            "type": "rule",
            "size": 1,
            "color": "#9a9a9a",
            "strokeDash": [3, 3],
            "tooltip": null
          },
          "encoding": {
            "y2": { "datum": 5.25, "type": "quantitative" }
          }
        },
        {
          "name": "lollipops",
          "mark": {
            "type": "point",
            "size": 240,
            "filled": true,
            "color": "#3767b1",
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "tooltip": [
              { "field": "label", "title": "Mutation" },
              { "field": "position", "title": "Residue" },
              { "field": "count", "title": "Count" }
            ]
          }
        },
        {
          "name": "point-values",
          "mark": {
            "type": "text",
            "size": 10,
            "fontWeight": "bold",
            "align": "center",
            "baseline": "middle",
            "color": "white",
            "tooltip": null
          },
          "encoding": {
            "text": { "field": "count", "type": "quantitative" }
          }
        },
        {
          "name": "mutation-labels",
          "mark": {
            "type": "text",
            "angle": -90,
            "dx": 4,
            "size": 11,
            "align": "left",
            "baseline": "middle",
            "color": "#303030",
            "tooltip": null
          },
          "encoding": {
            "y": { "datum": 5.25, "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    },

    {
      "name": "protein",
      "height": 48,
      "data": {
        "values": [
          { "start": 25, "end": 72, "name": "RING" },
          { "start": 340, "end": 505, "name": "BRCT assoc" },
          { "start": 650, "end": 980, "name": "Central domain" },
          { "start": 1645, "end": 1710, "name": "BRCT-N" },
          { "start": 1740, "end": 1815, "name": "BRCT-C" }
        ]
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "index",
          "axis": { "title": "Protein position (aa)", "tickCount": 10 }
        },
        "x2": { "field": "end" }
      },
      "layer": [
        {
          "name": "protein-backbone",
          "data": { "values": [{ "start": 0, "end": 1863 }] },
          "mark": {
            "type": "rect",
            "y": 0.36,
            "y2": 0.64,
            "color": "#b9bdb8",
            "tooltip": null
          }
        },
        {
          "name": "domains",
          "mark": {
            "type": "rect",
            "y": 0.18,
            "y2": 0.82,
            "cornerRadius": 2,
            "color": "#6359e8"
          },
          "encoding": {
            "tooltip": [
              { "field": "name", "title": "Domain" },
              { "field": "start", "title": "Start" },
              { "field": "end", "title": "End" }
            ]
          }
        },
        {
          "name": "domain-labels",
          "mark": {
            "type": "text",
            "y": 0.5,
            "size": 10,
            "color": "white",
            "paddingX": 3,
            "tooltip": null
          },
          "encoding": { "text": { "field": "name" } }
        }
      ]
    }
  ]
}
