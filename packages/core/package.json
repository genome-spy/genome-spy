{
  "name": "@genome-spy/core",
  "description": "GenomeSpy, a visualization grammar and a GPU-accelerated rendering engine for genomic (and other) data",
  "author": {
    "name": "Kari Lavikka",
    "email": "kari.lavikka@helsinki.fi"
  },
  "contributors": [],
  "license": "MIT",
  "version": "0.85.0",
  "jsdelivr": "dist/bundle/index.js",
  "unpkg": "dist/bundle/index.js",
  "browser": "dist/bundle/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./minimal": "./src/minimal.js",
    "./full": "./src/full.js",
    "./browser": {
      "import": "./dist/bundle/index.es.js",
      "default": "./dist/bundle/index.js"
    },
    "./svg/index.js": "./src/rendering/svg/index.js",
    "./data/*": "./src/data/*",
    "./*": "./src/*",
    "./schema.json": "./dist/schema.json"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "github:genome-spy/genome-spy",
    "directory": "packages/core"
  },
  "scripts": {
    "dev": "node dev-server.mjs",
    "capture:screenshots": "node scripts/captureScreenshots.mjs",
    "benchmark:interaction": "node scripts/runWebGpuInteractionBenchmark.mjs",
    "smoke:examples": "node scripts/captureScreenshots.mjs --all --check",
    "smoke:examples:webgpu": "node scripts/runWebGpuExamples.mjs --all",
    "verify:bundle:minimal": "node scripts/verifyMinimalBundle.mjs",
    "build": "rm -rf dist && mkdir -p dist && node scripts/build.mjs && vite build && npm run build:schema && npm run build:typings",
    "prepublishOnly": "npm run build",
    "test:tsc": "tsc -p tsconfig.json --noEmit",
    "build:schema": "mkdir -p dist && ts-json-schema-generator --path 'src/spec/*.ts' --type CoreRootSpec > dist/schema.json",
    "build:typings": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationMap --outDir dist/src && node scripts/removeDevelopmentOnlyArtifacts.mjs",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@gmod/bam": "^7.1.19",
    "@gmod/bbi": "^9.2.0",
    "@gmod/bed": "^2.1.10",
    "@gmod/indexedfasta": "^5.0.2",
    "@gmod/tabix": "3.2.2",
    "@gmod/vcf": "^7.0.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@uwdata/flechette": "^2.5.0",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-dsv": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-format": "^3.1.0",
    "events": "^3.3.0",
    "flatqueue": "^3.0.0",
    "generic-filehandle2": "^2.0.18",
    "gff-nostream": "^3.0.2",
    "hyparquet": "^1.25.0",
    "internmap": "^2.0.3",
    "lit": "^3.3.0",
    "twgl.js": "^4.19.1",
    "vega-expression": "^6.1.0",
    "vega-loader": "^5.1.0",
    "vega-scale": "^8.1.0",
    "vega-util": "2.1.0"
  },
  "devDependencies": {
    "@genome-spy/webgpu-renderer": "^0.64.0",
    "@types/long": "^4.0.1"
  }
}
