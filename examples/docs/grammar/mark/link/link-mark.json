{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": "Link mark example.",

  "data": {
    "sequence": { "start": 0, "stop": 10, "as": "z" }
  },

  "transform": [
    { "type": "formula", "expr": "pow(2, datum.z)", "as": "start" },
    { "type": "formula", "expr": "datum.start * 2", "as": "end" }
  ],

  "mark": "link",

  "encoding": {
    "x": { "field": "start", "type": "index" },
    "x2": { "field": "end" }
  }
}
