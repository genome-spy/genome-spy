{
  "description": "Rect mark example.",

  "params": [
    {
      "name": "strokeAlign",
      "value": "center",
      "bind": { "input": "select", "options": ["inside", "center", "outside"] }
    },
    {
      "name": "strokeWidth",
      "value": 2,
      "bind": { "input": "range", "min": 0, "max": 16, "step": 0.5 }
    }
  ],

  "data": {
    "sequence": { "start": 0, "stop": 20, "as": "z" }
  },

  "transform": [
    { "type": "formula", "as": "x", "expr": "random()" },
    { "type": "formula", "as": "x2", "expr": "datum.x + random() * 0.3" },
    { "type": "formula", "as": "y", "expr": "random()" },
    { "type": "formula", "as": "y2", "expr": "datum.y + random() * 0.4" }
  ],

  "mark": {
    "type": "rect",
    "strokeWidth": { "expr": "strokeWidth" },
    "strokeAlign": { "expr": "strokeAlign" },
    "stroke": "#404040",
    "cornerRadius": 5
  },

  "encoding": {
    "x": { "field": "x", "type": "quantitative" },
    "x2": { "field": "x2" },
    "y": { "field": "y", "type": "quantitative" },
    "y2": { "field": "y2" },
    "color": { "field": "z", "type": "quantitative" }
  }
}
