{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",

  "description": [
    "Local and root legend placement",
    "One legend stays below its view while another is collected to the right of the root view."
  ],

  "vconcat": [
    {
      "data": {
        "values": [
          { "x": 1, "group": "A" },
          { "x": 2, "group": "B" },
          { "x": 3, "group": "A" }
        ]
      },
      "mark": { "type": "point", "filled": true, "size": 65 },
      "encoding": {
        "x": { "field": "x", "type": "quantitative", "axis": null },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": {
            "placement": "local",
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Local"
          }
        }
      }
    },

    {
      "data": {
        "values": [
          { "x": 1, "status": "pass" },
          { "x": 2, "status": "review" },
          { "x": 3, "status": "fail" }
        ]
      },
      "mark": { "type": "point", "filled": true, "size": 65 },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "color": {
          "field": "status",
          "type": "nominal",
          "legend": {
            "placement": "root",
            "orient": "right",
            "title": "Root"
          }
        }
      }
    }
  ],

  "config": {
    "view": { "stroke": "lightgray" },
    "legend": { "layout": { "right": { "anchor": "middle" } } }
  }
}
