{
  "description": [
    "Select cells by activation state",
    "Select an activation state to highlight all matching cells. Coordinates, cell types, and activation states are synthetic."
  ],

  "title": {
    "text": "Select an activation state",
    "subtitle": "Shift-click to toggle; double-click to clear.",
    "anchor": "start"
  },

  "params": [
    { "name": "focus", "select": { "type": "point", "encodings": ["color"] } }
  ],

  "data": { "url": "data/immune-cell-activation.csv" },

  "mark": { "type": "point", "size": 110, "filled": true, "tooltip": null },

  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "scale": { "domain": [0, 9] },
      "axis": null
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "scale": { "domain": [0, 7] },
      "axis": null
    },
    "color": {
      "field": "activation_state",
      "type": "ordinal",
      "scale": {
        "domain": ["resting", "intermediate", "activated"],
        "range": ["#b8d4df", "#4099b3", "#075875"]
      },
      "legend": { "title": "Activation", "orient": "right" }
    },
    "shape": {
      "field": "cell_type",
      "type": "nominal",
      "scale": {
        "domain": ["T cell", "B cell"],
        "range": ["circle", "diamond"]
      },
      "legend": { "title": "Cell type", "orient": "right" }
    },
    "opacity": {
      "condition": { "param": "focus", "value": 1 },
      "value": 0.12
    },
    "order": { "condition": { "param": "focus", "value": 1 }, "value": 0 }
  }
}
