{
  "description": [
    "Categorical focus across immune-cell views",
    "Select an activation state to highlight matching cells across linked views. All coordinates, cell types, and activation states are synthetic and illustrative."
  ],

  "title": {
    "text": "Activation focus across immune-cell views",
    "subtitle": "Click to replace · Shift-click to toggle · Double-click to clear. Synthetic, illustrative data.",
    "anchor": "start"
  },

  "params": [
    { "name": "focus", "select": { "type": "point", "encodings": ["color"] } }
  ],

  "data": { "url": "data/immune-cell-activation.csv" },

  "spacing": 18,
  "vconcat": [
    {
      "spacing": 26,
      "resolve": { "scale": { "color": "shared", "shape": "shared" } },
      "config": {
        "view": { "continuousWidth": 210, "continuousHeight": 210 },
        "point": { "size": 110, "filled": true, "tooltip": null }
      },

      "scales": {
        "color": {
          "domain": ["resting", "intermediate", "activated"],
          "range": ["#b8d4df", "#4099b3", "#075875"]
        }
      },
      "legends": { "color": { "title": "Activation", "orient": "bottom" } },

      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": { "domain": [0, 9] },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": { "domain": [0, 7] },
          "axis": null
        },
        "color": { "field": "activation_state", "type": "ordinal" },
        "shape": {
          "field": "cell_type",
          "type": "nominal",
          "scale": {
            "domain": ["T cell", "B cell"],
            "range": ["circle", "diamond"]
          },
          "legend": { "title": "Cell type", "orient": "bottom" }
        },
        "opacity": {
          "condition": { "param": "focus", "value": 1 },
          "value": 0.12
        },
        "order": { "condition": { "param": "focus", "value": 1 }, "value": 0 }
      },

      "hconcat": [
        {
          "name": "activation-source",
          "title": {
            "text": "Select an activation state",
            "subtitle": "All cells in that state are highlighted"
          },
          "params": [
            {
              "name": "focus",
              "select": { "type": "point", "encodings": ["color"] },
              "push": "outer"
            }
          ],
          "mark": "point"
        },

        {
          "name": "activation-reader",
          "title": {
            "text": "Linked category focus",
            "subtitle": "The field is renamed to activation"
          },
          "transform": [
            {
              "type": "formula",
              "expr": "datum.activation_state",
              "as": "activation"
            }
          ],
          "mark": "point",
          "encoding": { "color": { "field": "activation", "type": "ordinal" } }
        }
      ]
    },

    {
      "name": "selection-feedback",
      "height": 20,
      "data": { "values": [{}] },
      "mark": {
        "type": "text",
        "align": "left",
        "size": 12,
        "tooltip": null,
        "text": {
          "expr": "'Activation focus: ' + (selectionActive(focus) ? join(selectionValues(focus, 'color'), ', ') : 'all states')"
        }
      },
      "encoding": { "x": { "value": 0 }, "y": { "value": 0.5 } }
    }
  ]
}
