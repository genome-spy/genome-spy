{
  "description": [
    "Matrix with aligned summaries and annotations",
    "Aligns column and row summaries, row metadata, and column labels around a central matrix."
  ],

  "data": {
    "values": [
      { "column": "One", "row": "Alpha", "value": 2 },
      { "column": "Two", "row": "Alpha", "value": 5 },
      { "column": "Three", "row": "Alpha", "value": 8 },
      { "column": "One", "row": "Beta", "value": 7 },
      { "column": "Two", "row": "Beta", "value": 3 },
      { "column": "Three", "row": "Beta", "value": 1 },
      { "column": "One", "row": "Gamma", "value": 4 },
      { "column": "Two", "row": "Gamma", "value": 8 },
      { "column": "Three", "row": "Gamma", "value": 6 }
    ]
  },

  "scales": {
    "x": {
      "type": "band",
      "domain": ["One", "Two", "Three"],
      "paddingInner": 0.08
    },
    "y": {
      "type": "band",
      "domain": ["Alpha", "Beta", "Gamma"],
      "reverse": true,
      "paddingInner": 0.08
    }
  },
  "resolve": { "legend": { "color": "collected" } },
  "spacing": 8,

  "surround": {
    "top": [
      {
        "name": "columnTotals",
        "height": 60,
        "transform": [
          {
            "type": "aggregate",
            "groupby": ["column"],
            "fields": ["value"],
            "ops": ["sum"],
            "as": ["total"]
          }
        ],
        "mark": { "type": "rect", "color": "#64748b" },
        "encoding": {
          "x": { "field": "column", "type": "nominal", "axis": null },
          "y": {
            "field": "total",
            "type": "quantitative",
            "axis": { "title": "Column total", "tickCount": 3 }
          }
        }
      }
    ],

    "left": [
      {
        "name": "rowTotals",
        "width": 70,
        "scales": { "x": { "reverse": true } },
        "transform": [
          {
            "type": "aggregate",
            "groupby": ["row"],
            "fields": ["value"],
            "ops": ["sum"],
            "as": ["total"]
          }
        ],
        "mark": { "type": "rect", "color": "#64748b" },
        "encoding": {
          "x": {
            "field": "total",
            "type": "quantitative",
            "axis": { "title": "Row total", "tickCount": 3 }
          },
          "y": { "field": "row", "type": "nominal", "axis": null }
        }
      }
    ],

    "right": [
      {
        "name": "category",
        "width": 14,
        "data": {
          "values": [
            { "row": "Alpha", "category": "A" },
            { "row": "Beta", "category": "B" },
            { "row": "Gamma", "category": "A" }
          ]
        },
        "mark": "rect",
        "encoding": {
          "y": {
            "field": "row",
            "type": "nominal",
            "axis": { "orient": "right", "title": null }
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "legend": { "title": "Category" }
          }
        }
      }
    ]
  },

  "spec": {
    "name": "matrix",
    "width": 180,
    "height": 120,
    "mark": "rect",
    "encoding": {
      "x": {
        "field": "column",
        "type": "nominal",
        "axis": { "title": null, "labelAngle": 0 }
      },
      "y": { "field": "row", "type": "nominal", "axis": null },
      "color": {
        "field": "value",
        "type": "quantitative",
        "legend": { "title": "Value" }
      },
      "tooltip": { "field": "value", "type": "quantitative" }
    }
  },

  "config": {
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 80
    }
  }
}
