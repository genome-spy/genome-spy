      { "gene": "KRAS", "sample": "S1", "value": -1.6 },
      { "gene": "TP53", "sample": "S2", "value": 1.1 },
      { "gene": "BRCA1", "sample": "S2", "value": 1.5 },
      { "gene": "EGFR", "sample": "S2", "value": -0.8 },
      { "gene": "KRAS", "sample": "S2", "value": -1.2 },
      { "gene": "TP53", "sample": "S3", "value": -1.3 },
      { "gene": "BRCA1", "sample": "S3", "value": -0.9 },
      { "gene": "EGFR", "sample": "S3", "value": 1.7 },
      { "gene": "KRAS", "sample": "S3", "value": 0.8 },
      { "gene": "TP53", "sample": "S4", "value": -1.6 },
