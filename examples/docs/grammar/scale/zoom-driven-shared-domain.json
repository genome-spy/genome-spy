{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Zoom-Driven Shared Domain",
    "The shared y domain follows the magnification of the zoomable x scale."
  ],

  "data": {
    "values": [
      { "x": 0, "y": 1 },
      { "x": 20, "y": 3 },
      { "x": 40, "y": 2 },
      { "x": 60, "y": 3 },
      { "x": 80, "y": 8 },
      { "x": 100, "y": 5 }
    ]
  },

  "scales": {
    "x": { "domain": [0, 100], "zoom": true },
    "y": { "domain": { "expr": "[0, 10 / zoomLevel('x')]" } }
  },

  "layer": [
    {
      "data": { "values": [{ "threshold": 5 }] },
      "mark": { "type": "rule", "strokeDash": [4, 4] },
      "encoding": {
        "y": {
          "field": "threshold",
          "type": "quantitative",
          "title": "Value"
        }
      }
    },
    {
      "mark": { "type": "point", "size": 80 },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "field": "y", "type": "quantitative", "title": "Value" }
      }
    }
  ]
}
