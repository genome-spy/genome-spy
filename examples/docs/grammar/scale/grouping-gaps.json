{
  "description": [
    "Grouped heatmap",
    "Grouping gaps separate clustered heatmap rows and columns while keeping their pixel widths during zooming."
  ],

  "data": { "sequence": { "start": 0, "stop": 200, "as": "cell" } },

  "transform": [
    { "type": "formula", "expr": "datum.cell % 20", "as": "column" },
    { "type": "formula", "expr": "floor(datum.cell / 20)", "as": "row" },
    {
      "type": "formula",
      "expr": "sin(datum.column * 0.7 + datum.row)",
      "as": "value"
    }
  ],

  "mark": "rect",

  "encoding": {
    "x": {
      "field": "column",
      "type": "index",
      "scale": { "domain": [0, 19], "gapPositions": [5, 12], "gapWidth": 8 }
    },
    "y": {
      "field": "row",
      "type": "index",
      "scale": { "domain": [0, 9], "gapPositions": [4, 7], "gapWidth": 8 }
    },
    "color": {
      "field": "value",
      "type": "quantitative",
      "legend": { "style": null }
    }
  }
}
