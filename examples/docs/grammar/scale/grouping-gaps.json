{
  "description": "Grouping gaps separate clustered heatmap rows and columns while keeping their pixel widths during zooming.",

  "width": 450,
  "height": 220,
  "data": { "sequence": { "start": 0, "stop": 200, "as": "cell" } },
  "transform": [
    { "type": "formula", "expr": "datum.cell % 20", "as": "column" },
    { "type": "formula", "expr": "floor(datum.cell / 20)", "as": "row" },
    {
      "type": "formula",
      "expr": "sin(datum.column * 0.7 + datum.row)",
      "as": "value"
    }
  ],

  "mark": "rect",
  "encoding": {
    "x": {
      "field": "column",
      "type": "index",
      "scale": { "gapPositions": [5, 12], "gapWidth": 8, "zoom": true }
    },
    "y": {
      "field": "row",
      "type": "index",
      "scale": { "gapPositions": [4, 7], "gapWidth": 8, "zoom": true }
    },
    "color": { "field": "value", "type": "quantitative" }
  }
}
