{
  "description": [
    "Fractional index dendrogram",
    "Leaves align with row centers; parent branches meet connector midpoints. The padded index scale stays zoomable."
  ],

  "width": 300,
  "height": 200,
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "scale": { "domain": [0, 3] },
      "axis": null
    },
    "y": {
      "field": "y",
      "type": "index",
      "band": 0.5,
      "scale": {
        "domain": [0, 3],
        "fractional": true,
        "paddingInner": 0.3,
        "paddingOuter": 0.2
      },
      "axis": { "title": "Row" }
    }
  },

  "layer": [
    {
      "data": {
        "values": [
          { "x": 0, "x2": 1, "y": 0, "y2": 0 },
          { "x": 0, "x2": 1, "y": 1, "y2": 1 },
          { "x": 0, "x2": 1, "y": 2, "y2": 2 },
          { "x": 0, "x2": 1, "y": 3, "y2": 3 },
          { "x": 1, "x2": 1, "y": 0, "y2": 1 },
          { "x": 1, "x2": 1, "y": 2, "y2": 3 },
          { "x": 1, "x2": 2, "y": 0.5, "y2": 0.5 },
          { "x": 1, "x2": 2, "y": 2.5, "y2": 2.5 },
          { "x": 2, "x2": 2, "y": 0.5, "y2": 2.5 },
          { "x": 2, "x2": 3, "y": 1.5, "y2": 1.5 }
        ]
      },
      "mark": { "type": "rule", "size": 2 },
      "encoding": {
        "x2": { "field": "x2" },
        "y2": { "field": "y2", "band": 0.5 }
      }
    },

    {
      "data": {
        "values": [
          { "x": 0, "y": 0 },
          { "x": 0, "y": 1 },
          { "x": 0, "y": 2 },
          { "x": 0, "y": 3 }
        ]
      },
      "mark": { "type": "point", "size": 80, "color": "#6a51a3" }
    }
  ]
}
