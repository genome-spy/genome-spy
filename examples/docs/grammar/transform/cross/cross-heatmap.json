{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Crossed sequences as a heatmap",
    "Crosses two generated sequences to form a grid."
  ],

  "data": {
    "sequence": { "start": 0, "stop": 6, "as": "x" }
  },

  "transform": [
    {
      "type": "cross",
      "from": {
        "data": {
          "sequence": { "start": 0, "stop": 4, "as": "y" }
        }
      }
    },
    {
      "type": "formula",
      "expr": "datum.x + 1",
      "as": "x2"
    },
    {
      "type": "formula",
      "expr": "datum.y + 1",
      "as": "y2"
    },
    {
      "type": "formula",
      "expr": "(datum.x + 1) * (datum.y + 1)",
      "as": "value"
    }
  ],

  "width": 300,
  "height": 180,

  "mark": "rect",

  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "axis": { "title": "Primary sequence", "tickMinStep": 1 }
    },
    "x2": { "field": "x2" },
    "y": {
      "field": "y",
      "type": "quantitative",
      "axis": { "title": "Foreign sequence", "tickMinStep": 1 }
    },
    "y2": { "field": "y2" },
    "color": {
      "field": "value",
      "type": "quantitative",
      "scale": { "scheme": "viridis" }
    }
  }
}
