    "y": {
      "field": "y0",
      "type": "quantitative",
      "axis": { "title": "Contribution" }
    },
    "y2": { "field": "y1" },
    "color": {
      "field": "component",
      "type": "nominal",
      "legend": { "title": "Component" }
    },
    "tooltip": [
      { "field": "component", "title": "Component" },
      { "field": "value", "title": "Contribution", "format": "+.0f" }
    ]
  }
