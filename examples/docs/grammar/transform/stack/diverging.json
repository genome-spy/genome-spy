  "description": "Signed contributions by group",

  "data": {
    "values": [
      { "group": "Control", "component": "A", "value": 2 },
      { "group": "Control", "component": "B", "value": 1 },
      { "group": "Control", "component": "C", "value": -1 },
      { "group": "Control", "component": "D", "value": -2 },
      { "group": "Treatment A", "component": "A", "value": 4 },
      { "group": "Treatment A", "component": "B", "value": -1 },
      { "group": "Treatment A", "component": "C", "value": 2 },
      { "group": "Treatment A", "component": "D", "value": -1 },
      { "group": "Treatment B", "component": "A", "value": -2 },
      { "group": "Treatment B", "component": "B", "value": 3 },
      { "group": "Treatment B", "component": "C", "value": 0 },
      { "group": "Treatment B", "component": "D", "value": -2 }
    ]
  },

  "transform": [
    {
      "type": "stack",
      "field": "value",
      "groupby": ["group"],
      "sort": { "field": "component" },
      "offset": "diverging"
