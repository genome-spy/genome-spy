{
  "description": [
    "Penguin Body Mass Boxplot",
    "Shows quartiles, inlier whiskers, and observations beyond the 1.5×IQR fences for each species."
  ],

  "width": 300,
  "height": 200,

  "data": {
    "url": "vega-datasets/penguins.json"
  },

  "transform": [
    {
      "type": "filter",
      "expr": "isValid(datum['Body Mass (g)']) && isFinite(datum['Body Mass (g)'])"
    },
    {
      "type": "window",
      "groupby": ["Species"],
      "frame": [null, null],
      "fields": ["Body Mass (g)", "Body Mass (g)", "Body Mass (g)"],
      "ops": ["q1", "median", "q3"],
      "as": ["q1BodyMass", "medianBodyMass", "q3BodyMass"]
    },
    {
      "type": "formula",
      "expr": "1.5 * (datum.q3BodyMass - datum.q1BodyMass)",
      "as": "fenceOffset"
    },
    {
      "type": "formula",
      "expr": "datum['Body Mass (g)'] < datum.q1BodyMass - datum.fenceOffset || datum['Body Mass (g)'] > datum.q3BodyMass + datum.fenceOffset",
      "as": "isOutlier"
    }
  ],

  "encoding": {
    "x": {
      "field": "Species",
      "type": "nominal",
      "title": null,
      "scale": { "padding": 0.4 },
      "axis": { "labelAngle": 0 }
    }
  },

  "layer": [
    {
      "transform": [
        { "type": "filter", "expr": "!datum.isOutlier" },
        {
          "type": "aggregate",
          "groupby": ["Species"],
          "fields": [
            "Body Mass (g)",
            "q1BodyMass",
            "medianBodyMass",
            "q3BodyMass",
            "Body Mass (g)"
          ],
          "ops": ["min", "max", "max", "max", "max"],
          "as": [
            "minBodyMass",
            "q1BodyMass",
            "medianBodyMass",
            "q3BodyMass",
            "maxBodyMass"
          ],
          "description": "Find the inlier whisker endpoints and carry forward the full-group quartiles."
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#7b8794",
            "size": 2,
            "tooltip": null
          },
          "encoding": {
            "y": {
              "field": "minBodyMass",
              "type": "quantitative",
              "scale": { "zero": false },
              "axis": { "title": "Body mass (g)" }
            },
            "y2": { "field": "maxBodyMass" }
          }
        },

        {
          "mark": {
            "type": "rect",
            "stroke": "#243b53",
            "strokeWidth": 1,
            "tooltip": null
          },
          "encoding": {
            "y": { "field": "q3BodyMass", "type": "quantitative" },
            "y2": { "field": "q1BodyMass" },
            "color": {
              "field": "Species",
              "type": "nominal",
              "scale": {
                "domain": ["Chinstrap", "Adelie", "Gentoo"],
                "range": ["#BF5CCA", "#FF6C02", "#0F7574"]
              }
            }
          }
        },

        {
          "mark": {
            "type": "tick",
            "color": "#102a43",
            "thickness": 2,
            "tooltip": null
          },
          "encoding": {
            "y": { "field": "medianBodyMass", "type": "quantitative" }
          }
        },

        {
          "mark": {
            "type": "tick",
            "color": "#243b53",
            "thickness": 2,
            "tooltip": null
          },
          "encoding": {
            "x": {
              "field": "Species",
              "type": "nominal",
              "band": 0.3
            },
            "y": { "field": "minBodyMass", "type": "quantitative" }
          }
        },

        {
          "mark": {
            "type": "tick",
            "color": "#243b53",
            "thickness": 2,
            "tooltip": null
          },
          "encoding": {
            "x": {
              "field": "Species",
              "type": "nominal",
              "band": 0.3
            },
            "y": { "field": "maxBodyMass", "type": "quantitative" }
          }
        }
      ]
    },

    {
      "transform": [{ "type": "filter", "expr": "datum.isOutlier" }],
      "mark": {
        "type": "point",
        "filled": false,
        "color": "#243b53",
        "size": 25,
        "strokeWidth": 1
      },
      "encoding": {
        "y": { "field": "Body Mass (g)", "type": "quantitative" },
        "tooltip": [{ "field": "Species" }, { "field": "Body Mass (g)" }]
      }
    }
  ]
}
