{
  "description": [
    "Adaptive ticks on log gradient legends",
    "Both ramps use the same color scale. The long ramp shows minor ticks, and the short ramp shows fewer ticks and labels."
  ],

  "background": "#fafafa",

  "width": 700,
  "height": 300,
  "padding": { "top": 10, "right": 24, "bottom": 10, "left": 10 },

  "config": {
    "legend": { "disable": false, "offset": 18, "titlePadding": 10 }
  },

  "resolve": {
    "scale": { "color": "independent" },
    "axis": { "color": "independent" }
  },

  "data": {
    "sequence": { "start": 0, "stop": 241, "step": 1, "as": "x" }
  },

  "transform": [
    {
      "type": "formula",
      "expr": "pow(10, datum.x / 60)",
      "as": "value"
    }
  ],

  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "title": "Continuous x"
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Log y",
      "scale": { "type": "log", "domain": [1, 10000], "zero": false }
    }
  },

  "hconcat": [
    {
      "mark": { "type": "point", "filled": true, "opacity": 0.75, "size": 24 },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Log color",
          "scale": { "type": "log", "domain": [1, 10000], "zero": false },
          "legend": { "title": "Long ramp", "orient": "right" }
        }
      }
    },

    {
      "mark": { "type": "point", "filled": true, "opacity": 0.75, "size": 24 },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Log color",
          "scale": { "type": "log", "domain": [1, 10000], "zero": false },
          "legend": {
            "title": "Short ramp",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 70
          }
        }
      }
    }
  ]
}
