{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Horsepower and miles per gallon by origin",
    "Scatterplot of cars from the Vega-Lite dataset."
  ],

  "data": { "url": "vega-datasets/cars.json" },

  "mark": { "type": "point", "opacity": 0.7 },

  "encoding": {
    "x": { "field": "Horsepower", "type": "quantitative" },
    "y": { "field": "Miles_per_Gallon", "type": "quantitative" },
    "color": { "field": "Origin", "type": "nominal" },
    "shape": { "field": "Origin", "type": "nominal" }
  },

  "theme": "vegalite"
}
