{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "width": 600,

  "height": 600,

  "description": [
    "Pixel-aligned rule marks",
    "Checks that rule marks align perfectly to the pixel grid."
  ],

  "view": { "stroke": "#d0d0d0" },

  "data": {
    "sequence": { "start": 0, "stop": 600, "step": 10 }
  },

  "transform": [
    { "type": "formula", "expr": "datum.data + 0.0", "as": "data" }
  ],

  "layer": [
    {
      "mark": { "type": "rule", "clip": false },
      "encoding": {
        "x": { "field": "data", "type": "quantitative" }
      }
    },
    {
      "mark": { "type": "rule", "clip": false },
      "encoding": {
        "y": { "field": "data", "type": "quantitative" }
      }
    }
  ]
}
