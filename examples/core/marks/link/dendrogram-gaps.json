{
  "description": [
    "Gapped reversed dendrogram",
    "Fixed grouping gaps and reversed rows preserve branch connectivity and heatmap alignment."
  ],

  "datasets": {
    "tree": [
      { "id": "A", "parent": "AB", "height": 0, "row": 0 },
      { "id": "B", "parent": "AB", "height": 0, "row": 1 },
      { "id": "C", "parent": "ABC", "height": 0, "row": 2 },
      { "id": "D", "parent": "root", "height": 0, "row": 3 },
      { "id": "AB", "parent": "ABC", "height": 0.8 },
      { "id": "ABC", "parent": "root", "height": 1.6 },
      { "id": "root", "parent": null, "height": 3 }
    ]
  },

  "height": 240,
  "spacing": 12,
  "resolve": { "scale": { "y": "shared" } },
  "scales": {
    "y": {
      "type": "index",
      "domain": [0, 3],
      "paddingInner": 0.08,
      "paddingOuter": 0.15,
      "gapPositions": [1, 3],
      "gapWidth": 14,
      "reverse": true
    }
  },

  "hconcat": [
    {
      "name": "dendrogram",
      "width": 180,
      "data": { "name": "tree" },
      "transform": [
        {
          "type": "dendrogram",
          "key": "id",
          "parentKey": "parent",
          "height": "height",
          "leafIndex": "row"
        }
      ],
      "mark": {
        "type": "link",
        "linkShape": "orthogonal",
        "orient": "horizontal",
        "clip": "y",
        "size": 1.5
      },
      "encoding": {
        "x": {
          "field": "sourceHeight",
          "type": "quantitative",
          "scale": { "domain": [0, 3], "reverse": true },
          "axis": { "title": "Merge height" }
        },
        "x2": { "field": "targetHeight" },
        "y": {
          "field": "sourceIndex",
          "type": "index",
          "band": 0.5,
          "axis": null
        },
        "y2": { "field": "targetIndex", "band": 0.5 },
        "yOffset": {
          "field": "sourceOffset",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "range": [0, { "expr": "-height * step('y', height)" }]
          }
        },
        "y2Offset": { "field": "targetOffset" },
        "color": { "value": "#34495e" }
      }
    },

    {
      "name": "heatmap",
      "width": 320,
      "data": { "sequence": { "start": 0, "stop": 16, "as": "cell" } },
      "transform": [
        { "type": "formula", "expr": "datum.cell % 4", "as": "column" },
        { "type": "formula", "expr": "floor(datum.cell / 4)", "as": "row" },
        {
          "type": "formula",
          "expr": "sin(datum.column * 0.7 + datum.row)",
          "as": "value"
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "column",
          "type": "index",
          "scale": { "domain": [0, 3], "zoom": false },
          "axis": { "title": "Feature" }
        },
        "y": {
          "field": "row",
          "type": "index",
          "axis": { "orient": "right", "title": "Sample row" }
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": { "domain": [-1, 1], "scheme": "redblue" },
          "legend": null
        }
      }
    }
  ]
}
