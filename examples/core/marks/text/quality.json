{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Text mark rendering quality",
    "Renders varied text sizes, letters, and digits for visual inspection."
  ],

  "data": {
    "sequence": { "start": 1, "stop": 20, "step": 1 }
  },

  "mark": {
    "type": "text",
    "text": "Quick brown fox jumps over the lazy dog. 1234567890"
  },

  "encoding": {
    "y": { "field": "data", "type": "quantitative" },
    "size": { "field": "data", "type": "quantitative", "scale": null }
  }
}
