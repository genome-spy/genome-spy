{
  "$schema": "https://vega.github.io/schema/vega-lite/v4.json",

  "description": "Basic point plot of sine values",

  "data": { "url": "data/sincos.csv" },

  "mark": "point",

  "encoding": {
    "x": { "field": "x", "type": "quantitative" },
    "y": { "field": "sin", "type": "quantitative" }
  }
}
