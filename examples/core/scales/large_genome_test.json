{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Very large genome coordinates",
    "Tests genome coordinates beyond the range of 32-bit integers."
  ],

  "genome": {
    "name": "custom",
    "contigs": [
      { "name": "huge1", "size": 20000000000 },
      { "name": "huge2", "size": 40000000000 }
    ]
  },

  "data": {
    "values": [
      { "chrom": "huge1", "pos": 10000000000 },
      { "chrom": "huge2", "pos": 20000000000 }
    ]
  },

  "encoding": {
    "x": { "chrom": "chrom", "pos": "pos", "type": "locus" },
    "text": { "field": "pos" }
  },

  "mark": "text"
}
