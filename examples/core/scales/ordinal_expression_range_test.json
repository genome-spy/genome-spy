{
  "description": [
    "Expression-valued ordinal opacity range",
    "Five categories use separate opacity expressions. Move the slider to update all five range entries."
  ],

  "params": [
    {
      "name": "maxOpacity",
      "value": 0.8,
      "bind": {
        "input": "range",
        "name": "Maximum opacity",
        "min": 0.1,
        "max": 1,
        "step": 0.05
      }
    }
  ],

  "data": {
    "values": [
      { "category": "A" },
      { "category": "B" },
      { "category": "C" },
      { "category": "D" },
      { "category": "E" }
    ]
  },

  "width": 480,
  "height": 120,

  "mark": { "type": "point", "filled": true, "size": 1600, "strokeWidth": 0 },

  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "type": "point",
        "domain": ["A", "B", "C", "D", "E"],
        "padding": 0.5
      },
      "axis": { "labelAngle": 0 }
    },
    "y": { "value": 0.5 },
    "color": { "value": "steelblue" },
    "fillOpacity": {
      "field": "category",
      "type": "nominal",
      "legend": null,
      "scale": {
        "type": "ordinal",
        "domain": ["A", "B", "C", "D", "E"],
        "range": [
          { "expr": "maxOpacity * 0.2" },
          { "expr": "maxOpacity * 0.4" },
          { "expr": "maxOpacity * 0.6" },
          { "expr": "maxOpacity * 0.8" },
          { "expr": "maxOpacity" }
        ]
      }
    }
  }
}
