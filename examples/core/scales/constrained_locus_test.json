{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Constrained zoom extent and initial domain",
    "Sets a zoom limit and an initial locus domain."
  ],

  "genome": { "name": "hg38" },

  "data": {
    "values": [{ "chr": 5, "pos": 50000000 }]
  },

  "mark": "point",

  "encoding": {
    "x": {
      "chrom": "chr",
      "pos": "pos",
      "type": "locus",
      "scale": {
        "domain": [{ "chrom": "chr5" }],
        "zoom": {
          "extent": [{ "chrom": "chr3" }, { "chrom": "chr6" }]
        }
      }
    }
  }
}
