{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "description": [
    "Symmetric logarithmic scale",
    "Plots values with a symlog y-axis around zero."
  ],

  "data": {
    "sequence": { "start": -10, "stop": 10.1, "step": 0.5 }
  },

  "transform": [
    { "type": "formula", "expr": "datum.data / 1000", "as": "data" }
  ],

  "mark": "point",

  "encoding": {
    "x": { "field": "data", "type": "quantitative" },
    "y": {
      "field": "data",
      "type": "quantitative",
      "scale": { "type": "symlog", "constant": 0.0001 }
    }
  }
}
