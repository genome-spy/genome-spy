{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",
  "description": [
    "Automatic and disabled axis label layout",
    "Compares automatic axis label layout with disabled label layout."
  ],

  "data": {
    "values": [{ "value": 0 }, { "value": 800000000 }]
  },

  "vconcat": [
    {
      "title": "Automatic label layout",
      "width": 400,
      "height": 50,
      "mark": "point",
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "scale": { "domain": [0, 800000000], "zoom": true },
          "axis": {
            "values": [
              0, 100000000, 200000000, 300000000, 400000000, 500000000,
              600000000, 700000000, 800000000
            ],
            "tickCount": 20,
            "format": ",d"
          }
        }
      }
    },

    {
      "title": "Label layout disabled",
      "width": 400,
      "height": 50,
      "mark": "point",
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "scale": { "domain": [0, 800000000], "zoom": true },
          "axis": {
            "values": [
              0, 100000000, 200000000, 300000000, 400000000, 500000000,
              600000000, 700000000, 800000000
            ],
            "tickCount": 20,
            "format": ",d",
            "labelOverlap": false,
            "labelFlush": false
          }
        }
      }
    }
  ]
}
