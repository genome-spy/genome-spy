{
  "description": "Half-open intervals separate at chromosome boundaries. A spanning interval covers the internal gaps normally.",
  "assembly": "toy",
  "params": [
    {
      "name": "gapWidth",
      "value": 10,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 20
      }
    }
  ],
  "scales": {
    "x": {
      "type": "locus",
      "gapPositions": "chromosomes",
      "gapWidth": {
        "expr": "gapWidth"
      },
      "zoom": true
    }
  },
  "genomes": {
    "toy": {
      "contigs": [
        {
          "name": "chr1",
          "size": 10
        },
        {
          "name": "chr2",
          "size": 10
        },
        {
          "name": "chr3",
          "size": 10
        }
      ]
    }
  },
  "vconcat": [
    {
      "width": 500,
      "height": 160,
      "data": {
        "values": [
          {
            "start": 0,
            "end": 10,
            "row": 0
          },
          {
            "start": 10,
            "end": 20,
            "row": 0
          },
          {
            "start": 20,
            "end": 30,
            "row": 0
          },
          {
            "start": 0,
            "end": 30,
            "row": 1
          }
        ]
      },
      "layer": [
        {
          "mark": "rect",
          "encoding": {
            "x": {
              "field": "start",
              "type": "locus"
            },
            "x2": {
              "field": "end"
            },
            "y": {
              "field": "row",
              "type": "index",
              "scale": {
                "padding": 0.2
              }
            },
            "color": {
              "field": "row",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ]
}
