{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",
  "description": [
    "Reversed-axis displace2d test",
    "Exercises annotation displacement with both positional scales reversed."
  ],

  "title": "Clustered labels with both axes reversed",

  "data": {
    "values": [
      { "x": 4.82, "y": 5.08, "label": "TP53", "priority": 1 },
      { "x": 4.96, "y": 5.12, "label": "EGFR", "priority": 2 },
      { "x": 5.08, "y": 4.98, "label": "BRCA1", "priority": 3 },
      { "x": 4.91, "y": 4.89, "label": "PIK3CA", "priority": 4 },
      { "x": 5.18, "y": 5.09, "label": "MYC", "priority": 5 },
      { "x": 5.02, "y": 5.24, "label": "KRAS", "priority": 6 },
      { "x": 4.74, "y": 4.95, "label": "PTEN", "priority": 7 },
      { "x": 5.23, "y": 4.86, "label": "CDKN2A", "priority": 8 },
      { "x": 4.85, "y": 5.28, "label": "ERBB2", "priority": 9 },
      { "x": 5.3, "y": 5.2, "label": "BRAF", "priority": 10 },
      { "x": 5.12, "y": 5.31, "label": "ALK", "priority": 11 },
      { "x": 4.69, "y": 5.18, "label": "RB1", "priority": 12 }
    ]
  },

  "resolve": { "scale": { "x": "shared", "y": "shared" } },

  "layer": [
    {
      "mark": { "type": "point", "filled": true, "size": 50 },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": { "domain": [3.5, 6.5], "reverse": true, "zoom": true }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": { "domain": [3.5, 6.5], "reverse": true, "zoom": true }
        }
      }
    },

    {
      "name": "Annotations",
      "transform": [
        {
          "type": "measureText",
          "field": "label",
          "fontSize": 14,
          "fontWeight": "bold",
          "as": "labelWidth"
        },
        {
          "type": "formula",
          "expr": "datum.labelWidth + 6",
          "as": "collisionWidth"
        },
        {
          "type": "collect",
          "sort": { "field": "priority", "order": "ascending" }
        },
        {
          "type": "filter",
          "expr": "inrange(datum.x, domain('x')) && inrange(datum.y, domain('y'))"
        },
        {
          "type": "displace2d",
          "key": "label",
          "x": "x",
          "y": "y",
          "width": "collisionWidth",
          "height": 16,
          "anchorWidth": 12,
          "anchorHeight": 12,
          "as": ["labelDx", "labelDy"]
        },
        {
          "type": "formula",
          "expr": "max(0, 1 - min(datum.collisionWidth / 2 / max(abs(datum.labelDx), 1e-6), 8 / max(abs(datum.labelDy), 1e-6)))",
          "as": "leaderScale"
        },
        {
          "type": "formula",
          "expr": "datum.labelDx * datum.leaderScale",
          "as": "leaderDx"
        },
        {
          "type": "formula",
          "expr": "datum.labelDy * datum.leaderScale",
          "as": "leaderDy"
        }
      ],
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "field": "y", "type": "quantitative" },
        "tooltip": [
          { "field": "label", "type": "nominal" },
          { "field": "priority", "type": "quantitative" }
        ]
      },
      "layer": [
        {
          "name": "Leader lines",
          "mark": { "type": "rule", "color": "#606770" },
          "encoding": {
            "x2": { "field": "x" },
            "y2": { "field": "y" },
            "xOffset": {
              "field": "leaderDx",
              "type": "quantitative",
              "scale": null
            },
            "yOffset": {
              "field": "leaderDy",
              "type": "quantitative",
              "scale": null
            }
          }
        },
        {
          "name": "Labels",
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "size": 14,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": { "field": "label", "type": "nominal" },
            "xOffset": {
              "field": "labelDx",
              "type": "quantitative",
              "scale": null
            },
            "yOffset": {
              "field": "labelDy",
              "type": "quantitative",
              "scale": null
            }
          }
        }
      ]
    }
  ]
}
