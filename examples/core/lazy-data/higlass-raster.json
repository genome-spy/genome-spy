{
  "description": [
    "Zoomable Hi-C contact map",
    "Open with Canvas or WebGPU. Pan and zoom to explore. Drag on the logarithmic color legend to show a range of contact values. Double-click the legend to clear the brush.",
    "Data source: Rao et al. (2014), GM12878 MboI all replicates on hg19, served by HiGlass."
  ],
  "assembly": "hg19",
  "width": 600,
  "height": 600,

  "params": [
    {
      "name": "contactRange",
      "select": { "type": "interval", "encodings": ["color"] },
      "bind": "legend"
    }
  ],

  "data": {
    "lazy": {
      "type": "higlass",
      "url": "https://higlass.io/api/v1/",
      "tileset": "CQMd6V_cRw6iCI_-Unl3PQ"
    }
  },

  "mark": "raster",
  "encoding": {
    "x": {
      "dimension": "column",
      "type": "locus",
      "scale": {
        "domain": [
          { "chrom": "chr1", "pos": 49152000 },
          { "chrom": "chr1", "pos": 57343999 }
        ],
        "zoom": true,
        "name": "matrixX"
      }
    },
    "y": {
      "dimension": "row",
      "type": "locus",
      "scale": {
        "domain": [
          { "chrom": "chr1", "pos": 49152000 },
          { "chrom": "chr1", "pos": 57343999 }
        ],
        "reverse": true,
        "zoom": true,
        "name": "matrixY"
      }
    },
    "color": {
      "field": "value",
      "type": "quantitative",
      "title": "Contact value",
      "scale": {
        "type": "log",
        "domain": { "source": "viewport" },
        "scheme": "higlassFall",
        "clamp": true
      }
    },
    "opacity": {
      "condition": { "param": "contactRange", "value": 1 },
      "value": 0
    }
  }
}
