{
  "description": [
    "Hi-C triangle track",
    "Pan or zoom along the genomic axis. Hover over a cell to see the contact value and genomic bins. Height above the axis shows contact separation. Drag on the logarithmic color legend to filter contact values.",
    "The point and label mark an illustrative contact using the same projection as the heatmap.",
    "Data source: Rao et al. (2014), GM12878 MboI all replicates on hg19, served by HiGlass."
  ],
  "assembly": "hg19",
  "projection": "triangle",

  "scales": {
    "x": {
      "domain": [
        { "chrom": "chr1", "pos": 49152000 },
        { "chrom": "chr1", "pos": 57343999 }
      ]
    }
  },

  "params": [
    {
      "name": "contactRange",
      "select": {
        "type": "interval",
        "encodings": ["color"]
      },
      "bind": "legend"
    }
  ],

  "data": {
    "lazy": {
      "type": "higlass",
      "url": "https://higlass.io/api/v1/",
      "tileset": "CQMd6V_cRw6iCI_-Unl3PQ"
    }
  },

  "layer": [
    {
      "mark": "raster",
      "encoding": {
        "x": { "dimension": "column", "type": "locus" },
        "y": { "dimension": "row", "type": "locus" },
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "Contact value",
          "scale": {
            "type": "log",
            "scheme": "higlassfall",
            "clamp": true
          }
        },
        "opacity": {
          "condition": {
            "param": "contactRange",
            "value": 1
          },
          "value": 0
        }
      }
    },

    {
      "data": {
        "values": [{ "a": 51200000, "b": 52400000 }]
      },
      "encoding": {
        "x": { "field": "a", "type": "locus" },
        "y": { "field": "b", "type": "locus" }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "size": 64,
            "fill": "white",
            "stroke": "black",
            "clip": true,
            "tooltip": null
          }
        },
        {
          "mark": {
            "type": "text",
            "text": "Example contact",
            "baseline": "middle",
            "dx": 8,
            "clip": true,
            "tooltip": null
          }
        }
      ]
    },

    {
      "projection": null,
      "params": [
        { "name": "labelFontSize", "value": 11 },
        { "name": "labelLineHeight", "expr": "1.2 * labelFontSize" },
        { "name": "labelPadding", "value": 3 },
        { "name": "labelInset", "value": 4 }
      ],
      "transform": [
        { "type": "aggregate", "groupby": ["binSize"] },
        {
          "type": "formula",
          "as": "resolutionLabel",
          "expr": "'Current resolution: ' + format(datum.binSize, ',') + ' bp'"
        },
        {
          "type": "measureText",
          "field": "resolutionLabel",
          "fontSize": { "expr": "labelFontSize" },
          "as": "labelWidth"
        }
      ],
      "encoding": {
        "x": { "value": 1 },
        "y": { "value": 0 }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "fill": "white",
            "fillOpacity": 0.7,
            "x2": 1,
            "y2": 0,
            "x2Offset": { "expr": "-labelInset" },
            "yOffset": {
              "expr": "-labelInset - 2 * labelPadding - labelLineHeight"
            },
            "y2Offset": { "expr": "-labelInset" }
          },
          "encoding": {
            "xOffset": {
              "expr": "-labelInset - 2 * labelPadding - datum.labelWidth",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "size": { "expr": "labelFontSize" },
            "xOffset": { "expr": "-labelInset - labelPadding" },
            "yOffset": {
              "expr": "-labelInset - labelPadding - labelLineHeight / 2"
            }
          },
          "encoding": {
            "text": { "field": "resolutionLabel" }
          }
        }
      ]
    }
  ]
}
