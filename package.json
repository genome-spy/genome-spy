{
  "name": "root",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.1 || ^24 || >=26",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "^5.0.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/web-components-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/lib-dom": "npm:@types/web@0.0.352",
    "ajv": "^8.18.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.21.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "regenerator-runtime": "^0.13.9",
    "rollup": "^4.64.12",
    "rollup-plugin-glsl": "^1.3.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "run": "^1.5.0",
    "sass": "^1.106.0",
    "storybook": "^10.6.3",
    "ts-json-schema-generator": "^2.9.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "vega-datasets": "^3.2.1",
    "vite": "^8.3.5",
    "vite-raw-plugin": "^1.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "npm run build --if-present -w @genome-spy/webgpu-renderer -w @genome-spy/core -w @genome-spy/inspector -w @genome-spy/app-agent -w @genome-spy/app -w @genome-spy/doc-embed -w @genome-spy/react-component -w @genome-spy/embed-examples -w @genome-spy/playground",
    "build:schemas": "npm -w @genome-spy/core run build:schema && npm -w @genome-spy/app run build:schema",
    "build:docs:prepare": "npm -w @genome-spy/app run build && npm -w @genome-spy/doc-embed run build && npm -w @genome-spy/core run build:schema && node scripts/prepare-docs-assets.mjs && npm run generate:api-docs && npm run generate:doc-types",
    "build:docs": "npm run build:docs:prepare && uv run --group docs zensical build --clean",
    "build:dependency-graph": "depcruise packages/core/src/index.js --include-only '^packages/core/src' --output-type dot | dot -T svg | depcruise-wrap-stream-in-html > core-dependency-graph.html",
    "docs:install": "uv sync --group docs --locked",
    "docs:serve": "npm run build:docs:prepare && uv run --group docs zensical serve",
    "generate:api-docs": "typedoc --options typedoc.api.json && node scripts/normalize-api-reference.mjs",
    "check:api-docs": "npm run generate:api-docs && git diff --exit-code -- docs/api/reference",
    "generate:doc-types": "uv run --group docs python scripts/generate-doc-types.py",
    "check:doc-types": "uv run --group docs python scripts/generate-doc-types.py --check",
    "lint": "eslint packages/*/src/",
    "test": "vitest run",
    "start": "npm -w @genome-spy/app run dev",
    "smoke:examples": "npm -w @genome-spy/core run smoke:examples",
    "pretty-quick": "pretty-quick",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:check": "node scripts/checkChangesets.mjs",
    "release:version": "node scripts/release.mjs version",
    "release:notes": "node scripts/release.mjs notes",
    "release:publish": "npm run release:verify && changeset publish --no-git-tag",
    "release:plan": "changeset publish-plan",
    "release:verify": "node scripts/release.mjs verify",
    "release:pack": "npm pack -w @genome-spy/core -w @genome-spy/app -w @genome-spy/inspector -w @genome-spy/react-component"
  },
  "workspaces": [
    "./packages/*"
  ],
  "overrides": {
    "uuid": "^11.1.1"
  }
}
